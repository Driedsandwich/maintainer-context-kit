{
  "name": "maintainer-context-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first read-only CLI that turns GitHub maintainer context into task-specific Markdown packets.",
  "bin": {
    "mck": "./src/cli.ts"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "doctor": "node src/cli.ts doctor",
    "doctor:json": "node src/cli.ts doctor --json",
    "handoff": "node src/cli.ts handoff",
    "handoff:demo": "node src/cli.ts handoff --demo",
    "triage:demo": "node src/cli.ts triage --demo",
    "review:demo": "node src/cli.ts review --demo",
    "test": "node --test tests/*.test.ts"
  }
}
